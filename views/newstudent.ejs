<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <form method="post">
        <label>
            Név:<br>
            <input type="text" name="name">
        </label><br>

        <% if (locals.error) {%>
            <p style="color: red;">
                <%= locals.error %>
            </p>
            <% } %>

                <label>
                    Életkor:<br>
                    <input type="number" name="age">
                </label><br>

                <button type="submit">Új tanuló rögzítése</button>

                <ul>
                    <% students.forEach(element=> { %><li>
                            <%= element.name %>, <%= element.age %>
                        </li>
                        <% }); %>
                </ul>

    </form>
</body>

</html>